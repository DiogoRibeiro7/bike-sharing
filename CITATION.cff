url: "https://github.com/DiogoRibeiro7/bike-sharing/releases/tag/v1.0.0"
title: "Bike Sharing Forecasting: Temporal Evaluation and Asymmetric-Cost Planning"
authors:
  - family-names: Ribeiro
    given-names: Diogo
    orcid: "https://orcid.org/0009-0001-2022-7072"
